{
  "name": "vite-oxc-bridge",
  "version": "0.6.3",
  "description": "Use Oxc's Vite+ config discovery with Vite, without Vite+",
  "keywords": [
    "config",
    "formatter",
    "linter",
    "oxc",
    "oxfmt",
    "oxlint",
    "vite",
    "vite-plus"
  ],
  "homepage": "https://github.com/usercao/vite-oxc-bridge#readme",
  "bugs": {
    "url": "https://github.com/usercao/vite-oxc-bridge/issues"
  },
  "license": "MIT",
  "author": "usercao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usercao/vite-oxc-bridge.git"
  },
  "bin": {
    "oxc": "dist/cli.js",
    "oxfmt": "bin/oxfmt.js",
    "oxlint": "bin/oxlint.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "check": "yarn format:check && yarn lint && yarn test && yarn pack --dry-run",
    "format": "yarn exec oxfmt --write .",
    "format:check": "yarn exec oxfmt --check .",
    "lint": "yarn exec oxlint .",
    "lint:fix": "yarn exec oxlint --fix .",
    "prepack": "yarn build",
    "prepublishOnly": "yarn test",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit && vitest run"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "yarn@4.18.0"
}
