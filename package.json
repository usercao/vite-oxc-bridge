{
  "name": "vite-oxc-bridge",
  "version": "0.6.3",
  "description": "Use Oxc's Vite+ config discovery with Vite, without Vite+",
  "keywords": [
    "config",
    "formatter",
    "linter",
    "oxc",
    "oxfmt",
    "oxlint",
    "vite",
    "vite-plus"
  ],
  "homepage": "https://github.com/usercao/vite-oxc-bridge#readme",
  "bugs": {
    "url": "https://github.com/usercao/vite-oxc-bridge/issues"
  },
  "license": "MIT",
  "author": "usercao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usercao/vite-oxc-bridge.git"
  },
  "bin": {
    "oxc": "dist/cli.js",
    "oxfmt": "bin/oxfmt.js",
    "oxlint": "bin/oxlint.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "node scripts/check.ts",
    "format": "yarn exec oxfmt --write .",
    "format:check": "yarn exec oxfmt --check .",
    "lint": "yarn exec oxlint .",
    "lint:fix": "yarn exec oxlint --fix .",
    "prepack": "yarn build",
    "prepublishOnly": "yarn test",
    "test": "node scripts/test.ts",
    "test:package": "node scripts/package-smoke.ts",
    "test:windows": "node scripts/test-windows.ts"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "yarn@4.18.1"
}
